<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WildernessStays.Core</RootNamespace>
    <PackageId>WildernessStays.Core</PackageId>
    <Version>1.3.0</Version>
    <Authors>Charu Ingale</Authors>
    <Description>Data layer and business logic for the Wilderness Stays hotel reservation platform: entities, EF Core context, seeding, booking rules, availability engine, cancellation policy, auth, caching and payments.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.11" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    <PackageReference Include="StackExchange.Redis" Version="2.8.16" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="7.1.2" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data/hotels.json" />
  </ItemGroup>

</Project>
